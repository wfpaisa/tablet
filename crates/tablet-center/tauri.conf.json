{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tablet Center",
  "identifier": "dev.tabletcenter.linux",
  "version": "0.1.0",
  "build": {
    "frontendDist": "../../ui",
    "devUrl": "http://127.0.0.1:8765"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Tablet Center",
        "width": 1240,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 660,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
